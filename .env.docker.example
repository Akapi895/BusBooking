# PostgreSQL
DB_PASSWORD=CHANGE_ME

# JWT - Base64 encoded secret (minimum 32 decoded bytes)
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# Email OTP - separate secret
EMAIL_OTP_SECRET=REPLACE_WITH_OTP_SECRET

# OTP outbox encryption - separate Base64 secret encoding exactly 32 bytes
OTP_OUTBOX_SECRET=REPLACE_WITH_OUTBOX_SECRET

# dev (default) seeds demo accounts with a known password and enables Swagger.
# Use prod on any machine others can reach.
SPRING_PROFILES_ACTIVE=dev
